# DoorDesignPython .env configuration
# Place this file in the project root (same dir as run commands).
# Notes:
# - Boolean-like values: "1", "true", "yes" (case-insensitive) are treated as true.
# - MAX_FULL_BODY_BYTES is a number of bytes (1 MiB = 1048576). Default here 5 MiB.
# - ALLOWED_IPS: comma-separated list of IP addresses or CIDR ranges. Leave empty to allow all.

# Enable capturing full textual request/response bodies in per-request logs
FULL_BODY_LOGGING=true

# Maximum bytes allowed for including full request/response when FULL_BODY_LOGGING is enabled
# (set to 5242880 = 5 MiB by default)
MAX_FULL_BODY_BYTES=5242880

# Comma-separated allowed client IPs / CIDR ranges
# Example: ALLOWED_IPS=127.0.0.1,192.168.1.0/24
ALLOWED_IPS=""

# Server port used by the app (uvicorn will use this env var if present)
PORT=8000

# Optional: set to 1 to block at startup and wait for a debugger to attach
DEBUG_WAIT=0

# Clean, directory-only .gitignore
# This file ignores directories and common runtime/IDE folders only.
# Avoid listing individual files here (per request).

# Python runtime and caches
__pycache__/

# Virtual environments
venv/
env/
.venv/

# Build / distribution directories
build/
dist/
pip-wheel-metadata/

# CAD files
*.dxf
*.pdf

# IDEs and editors
.vscode/
.idea/

# Logs and generated output
logs/
fastapi_app/logs/
output/
outputBulk/

# Test case directories
ExcelTestCases/


# Authentication data (sensitive!)
fastapi_app/data/tokens.txt
fastapi_app/data/users.txt

# Environment variables (contains secrets)
.env

# Temporary / runtime directories
tmp/
temp/

# Node modules (if present)
node_modules/
/Door TestCases/validation_summary.json
/output_bins.zip
